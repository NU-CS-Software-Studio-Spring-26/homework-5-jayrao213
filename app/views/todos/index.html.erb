<p style="color: green"><%= notice %></p>

<% content_for :title, "Todos" %>

<h1>Todos</h1>

<div id="todos" data-controller="sortable" data-sortable-url-value="<%= reorder_todos_path %>">
  <% @todos.each do |todo| %>
    <div data-id="<%= todo.id %>" class="todo-item">
      <%= render todo %>
      <div class="todo-actions">
        <%= link_to "Show this todo", todo %>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "New todo", new_todo_path, class: "new-todo-btn" %>
